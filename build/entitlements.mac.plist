<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Kept to the minimum the app actually needs under the hardened runtime.

  allow-jit and allow-unsigned-executable-memory are required by V8 to generate
  and execute JIT-compiled code.

  Deliberately NOT included:
    disable-library-validation       — only needed to load native modules signed
                                       by another team. Ambora ships none.
    allow-dyld-environment-variables — only needed when the app relies on DYLD_*
                                       or ELECTRON_RUN_AS_NODE. It does not.
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
  </dict>
</plist>
